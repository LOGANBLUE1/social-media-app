# Copy to .env on the server and fill in. .env is gitignored -- never commit the real one.
#
#   cp .env.example .env && nano .env

DB_NAME=logandb
DB_USERNAME=postgres

# Generate, do not invent:  openssl rand -base64 24
DB_PASSWORD=

# Generate a NEW one for production:  openssl rand -base64 32
# Must differ from the local development value. Changing it later signs everyone out once.
JWT_SECRET=

# Exact origin of the deployed client -- scheme and host, no trailing slash, no path.
# Comma-separated if more than one. The Vercel URL goes here once the client is deployed.
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
